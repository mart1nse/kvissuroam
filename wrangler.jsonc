{
  // Static site: the game is built into ./dist and Cloudflare serves it as assets.
  // The build step runs here as well, so a deploy works even if the dashboard's
  // build command is left empty.
  "name": "kvissuroam",
  "compatibility_date": "2026-06-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
