{
  // The game is built into ./dist and Cloudflare serves it as static assets. The build step
  // runs here as well, so a deploy works even if the dashboard's build command is left empty.
  // worker/index.js answers /api/* (multiplayer and lap times) with one Durable Object.
  "name": "kvissuroam",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  // variables set in the Cloudflare dashboard (MAX_ONLINE: the online cap, at most 100) survive deploys
  "keep_vars": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
    // Everything that is a file in ./dist, the page itself too, is served straight from assets with no
    // Worker run: free, unlimited, and still up if a Workers spending limit ever stops the Worker. The
    // old addresses are sent on to www.linnaring.com by a script at the top of index.html.
  },
  // requests to /api/* from one address, counted in the Worker before they reach a Durable Object (worker/index.js).
  // A page makes a handful a minute; 30 players behind one address (a school, a LAN party) stay well inside.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      // anonymous game stats, one row of totals per day (worker/stats.js)
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  // SQLite-backed Durable Objects are what the Workers free plan offers
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] }
  ]
}
